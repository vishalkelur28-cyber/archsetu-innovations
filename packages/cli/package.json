{
  "name": "@archsetuweb/cli",
  "version": "0.1.23",
  "mcpName": "io.github.vishalkelur28-cyber/archsetu",
  "description": "MCP server and CLI that tells your coding agent what it is about to break: blast radius, dead code, and health for any local codebase. Runs entirely on your machine.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishalkelur28-cyber/archsetu-innovations.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/vishalkelur28-cyber/archsetu-innovations#readme",
  "bugs": "https://github.com/vishalkelur28-cyber/archsetu-innovations/issues",
  "author": "ArchSetu",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-agent",
    "static-analysis",
    "code-analysis",
    "call-graph",
    "dead-code",
    "codebase-health",
    "cli"
  ],
  "bin": {
    "archsetu": "./dist/cli.mjs"
  },
  "main": "./dist/cli.mjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1",
    "ora": "^8.0.1",
    "simple-git": "^4.0.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@archsetu/core": "workspace:*",
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
